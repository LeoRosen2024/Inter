# Local Docker configuration. Copy to .env and replace the password.
POSTGRES_DB=inter
POSTGRES_USER=inter
POSTGRES_PASSWORD=replace-with-a-long-random-password
INTER_HTTP_PORT=8080
ENVIRONMENT=development
SEED_DEMO_DATA=true
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://inter-1xr.pages.dev

# Apify remains disabled until the token and Actor ID are supplied.
APIFY_ENABLED=false
APIFY_TOKEN=
APIFY_ACTOR_ID=

